.DS_Store
.client-build/
node_modules
.pnpm-store/

# Local credentials and environment overrides must never be committed.
.env
.env.*
!.env.example
.npmrc
*.pem
*.key

# Local build/test output.
lib/
coverage/
*.log
*.tgz

# Generated native runtime payloads. Platform metadata and notices stay tracked.
npm/*/bin/
npm/*/web/
npm/*/openpencil-runtime.json

# Local visual acceptance evidence may contain workspace or conversation data.
artifacts/
dsh-actual-*.png
